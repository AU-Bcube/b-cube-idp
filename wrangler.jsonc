{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "b-cube-idp",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// public/assets/app.css는 `pnpm build:css`가 만든다. 파일이 없는 경로만 Worker로 간다.
	"assets": {
		"directory": "./public"
	},
	"routes": [
		{
			"pattern": "id.b-cube.kr",
			"custom_domain": true
		}
	],
	// 지정하지 않으면 wrangler dev가 Host와 Origin을 위 route 주소로 바꿔 동의 화면의 출처 검사가 실패한다.
	"dev": {
		"port": 8787,
		"host": "localhost:8787"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "b-cube-idp",
			// `pnpm wrangler d1 create b-cube-idp` 후 실제 id로 교체한다 (docs/MANUAL.md).
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	// 사용한 인가 코드 기록을 매일 정리한다.
	"triggers": {
		"crons": [
			"0 19 * * *"
		]
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"ISSUER": "https://id.b-cube.kr",
		"ALLOWED_EMAIL_DOMAIN": "ajou.ac.kr",
		"MHAKSA_INTERVAL_MS": "3000",
		"DEV_FAKE_LOGIN": "false",
		// 등록된 SP 목록. client_secret_sha256은 `pnpm client:secret`이 출력한 값이다.
		// 비밀값 자체는 SP에만 둔다. 해시는 256비트 랜덤 값의 해시라 공개 저장소에 두어도 된다.
		"CLIENTS": [
			{
				"client_id": "domain-console",
				"name": "B-Cube 도메인 콘솔",
				"redirect_uris": [
					"https://domain.b-cube.kr/auth/callback"
				],
				"scopes": [
					"openid",
					"email",
					"profile",
					"student"
				],
				"client_secret_sha256": "REPLACE_WITH_SHA256_HEX"
			}
		]
		// npx wrangler secret put <SECRET_NAME>
		// required secrets: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SIGNING_KEY, ENCRYPTION_SECRET
		// optional secrets: ADMIN_EMAILS (쉼표 구분. 비어 있으면 관리 화면을 쓸 수 없다)
	}
}