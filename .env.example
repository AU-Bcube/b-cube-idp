# 로컬 개발용 설정. `cp .env.example .env` 후 `pnpm keys`가 출력한 값을 채운다.
# .env는 절대 커밋하지 않는다. 운영 값은 Netlify 사이트 설정(Environment variables)에 넣는다.

DB_CONNECTION_STRING=
DB_NAME=

ISSUER=http://localhost:8787
# Google 계정과 mhaksa 조회 없이 가짜 학생으로 로그인한다. localhost에서만 켤 수 있다.
DEV_FAKE_LOGIN=false

SIGNING_KEY=
ENCRYPTION_SECRET=

# 실제 Google 로그인을 시험할 때만 채운다(DEV_FAKE_LOGIN=false).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 로컬 SP는 http://localhost:8787/admin 에서 만든다(DEV_FAKE_LOGIN=true이면 admin@ajou.ac.kr로 바로 들어간다).
# 관리 화면에 들어갈 학교 이메일. 쉼표로 구분한다.
ADMIN_EMAILS=

# 안내 페이지의 소스 코드 링크(AGPL). 이 저장소(또는 포크)의 GitHub 주소. 비우면 링크를 숨긴다.
SOURCE_URL=
